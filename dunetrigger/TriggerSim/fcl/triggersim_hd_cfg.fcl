# trigggersim.fcl

# This is the high-level configuration file for the HD dunetrigger tools
# It is imported in almost all HD fcls both of TriggerSim and TriggerAna
# The detector-independent services/source/outputs live in triggersim_common_cfg.fcl

#include "triggersim_common_cfg.fcl"

#include "trigger_primitive_makers_hd_cfg.fcl"
#include "trigger_activity_makers_hd_cfg.fcl"
#include "trigger_candidate_makers_hd_cfg.fcl"

BEGIN_PROLOG

# Producer chains. Each chain picks the module labels and sets every
# consumer's input tag (tp_tag/ta_tag) to match, so the maker prologs stay
# label-agnostic. makers_* is the matching trigger path.

# the simplest configurations are here as default
producers_triggersim_simpleThr_simpleWin_simpleWin: {
    tpmakerTPC: @local::tpmakerTPC_ADCSimpleThreshold
    tamakerTPC: { @table::tamakerTPC_ADCSimpleWindow tp_tag: "tpmakerTPC" }
    tcmakerTPC: { @table::tcmakerTPC_ADCSimpleWindow ta_tag: "tamakerTPC" }
}
makers_triggersim_simpleThr_simpleWin_simpleWin: [ tpmakerTPC, tamakerTPC, tcmakerTPC ]

# Run both AbsRS and SimpleThreshold TPG
producers_triggersim_simpleThr_absRS: {
    tpmakerTPCsimpleThr: @local::tpmakerTPC_ADCSimpleThreshold
    tpmakerTPCabsRS: @local::tpmakerTPC_ABSRunningSum
}
makers_triggersim_simpleThr_absRS: [ tpmakerTPCsimpleThr, tpmakerTPCabsRS ]

# this does not have analyzers! Add them
physics_triggersim_simpleThr_simpleWin_simpleWin: {
    producers: @local::producers_triggersim_simpleThr_simpleWin_simpleWin
    stream1: [ out1 ]
    makers: @local::makers_triggersim_simpleThr_simpleWin_simpleWin
    trigger_paths: [ makers ]
    end_paths: [ stream1 ]
}

END_PROLOG

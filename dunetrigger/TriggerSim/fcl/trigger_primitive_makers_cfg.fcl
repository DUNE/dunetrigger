# trigger_primitive_makers_cfg.fcl

# TP maker definitions.
# FD-HD configurations are the defaults.
# VD configurations inherit from the HD definitions and override only
# geometry-dependent parameters.

BEGIN_PROLOG

# ----------------------------------------------------------------------
# TP maker definitions
# ----------------------------------------------------------------------

# Simple threshold

tpmakerTPC_SimpleThreshold: {
  module_type: TriggerPrimitiveMakerTPC
  rawdigit_tag: "tpcrawdecoder:daq"
  tpalg: {
    tool_type: TPAlgTPCSimpleThreshold
    threshold_tpg_plane0: 70
    threshold_tpg_plane1: 70
    threshold_tpg_plane2: 60
    verbosity: 0
  }
}

# Absolute running sum

tpmakerTPC_ABSRunningSum: {
  module_type: TriggerPrimitiveMakerTPC
  rawdigit_tag: "tpcrawdecoder:daq"
  tpalg: {
    tool_type: TPAlgTPCAbsRunningSum
    accum_limit: 10
    scale_factor: 5
    r_value: 8
    threshold_tpg_plane0: 80
    threshold_tpg_plane1: 80
    threshold_tpg_plane2: 65
    verbosity: 0
  }
}

# ----------------------------------------------------------------------
# VD configurations
# ----------------------------------------------------------------------

# Same configuration as HD, only per-plane thresholds are varied.
# The tpmakerTPC_SimpleThreshold_vd is the default VD configuration.

tpmakerTPC_SimpleThreshold_vd_5sigma: @local::tpmakerTPC_SimpleThreshold
tpmakerTPC_SimpleThreshold_vd_5sigma.tpalg.threshold_tpg_plane0: 45
tpmakerTPC_SimpleThreshold_vd_5sigma.tpalg.threshold_tpg_plane1: 45
tpmakerTPC_SimpleThreshold_vd_5sigma.tpalg.threshold_tpg_plane2: 45

tpmakerTPC_SimpleThreshold_vd_4sigma: @local::tpmakerTPC_SimpleThreshold
tpmakerTPC_SimpleThreshold_vd_4sigma.tpalg.threshold_tpg_plane0: 36
tpmakerTPC_SimpleThreshold_vd_4sigma.tpalg.threshold_tpg_plane1: 36
tpmakerTPC_SimpleThreshold_vd_4sigma.tpalg.threshold_tpg_plane2: 36

tpmakerTPC_SimpleThreshold_vd_3sigma: @local::tpmakerTPC_SimpleThreshold
tpmakerTPC_SimpleThreshold_vd_3sigma.tpalg.threshold_tpg_plane0: 27
tpmakerTPC_SimpleThreshold_vd_3sigma.tpalg.threshold_tpg_plane1: 27
tpmakerTPC_SimpleThreshold_vd_3sigma.tpalg.threshold_tpg_plane2: 27


tpmakerTPC_SimpleThreshold_vd: @local::tpmakerTPC_SimpleThreshold_vd_4sigma

END_PROLOG
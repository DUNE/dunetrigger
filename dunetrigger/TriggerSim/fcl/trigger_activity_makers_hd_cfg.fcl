# trigger_activity_makers_hd_cfg.fcl

BEGIN_PROLOG

## These are producers

#======================================================================
# TA makers

ta_algconfig_simplewindow:
{
    window_length: 6000
    adc_threshold: 2000
}

ta_algconfig_adjacencyplugin:
{
    window_length: 4000
  adjacency_threshold: 15 # from triggeralgs default
    adj_tolerance: 3  # from triggeralgs default
}

ta_algconfig_swift:
{
  window_length: 32000
  inspect_energy_threshold_sadc: 15000
  accept_energy_threshold_sadc: 55000
  min_adc_peak: 80
  min_samples_over_threshold: 256
  cluster_energy_cut_sadc: 22000
}


tamakerTPC_SWIFT:
{
  module_type: TriggerActivityMakerTPC
  # tp_tag is set by the producer chain that uses this maker, next to the TP maker label
  algorithm: "TriggerActivityMakerSWIFTPlugin"
  #active_rops: []
  algconfig_rop0: @local::ta_algconfig_swift # collection rop2
  algconfig_rop1: @local::ta_algconfig_swift # collection rop2
  algconfig_rop2: @local::ta_algconfig_swift # collection rop2
  algconfig_rop3: @local::ta_algconfig_swift # collection rop3
  flush: true
  verbosity: 0
}

tamakerTPC_ADCSimpleWindow:
  {
    module_type: TriggerActivityMakerTPC
    # tp_tag is set by the producer chain that uses this maker, next to the TP maker label
    # simple window, see trgdataformats/include/trgdataformats/TriggerActivityData.hpp
    algorithm: "TriggerActivityMakerADCSimpleWindowPlugin" # another basic option is TriggerActivityMakerChannelAdjacencyPlugin
    algconfig_rop0: @local::ta_algconfig_simplewindow # induction 1
    algconfig_rop1: @local::ta_algconfig_simplewindow # induction 2
    algconfig_rop2: @local::ta_algconfig_simplewindow # collection facing one side (readout differentiates)
    algconfig_rop3: @local::ta_algconfig_simplewindow # collection facing the other side (readout differentiates)
    flush: true
    verbosity: 1
  }

END_PROLOG

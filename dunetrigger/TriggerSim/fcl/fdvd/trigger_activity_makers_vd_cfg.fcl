# trigger_activity_makers_vd_cfg.fcl

BEGIN_PROLOG

## These are producers

#======================================================================
# TA makers

ta_algconfig_swift_vd:
{
  window_length: 32000
  inspect_energy_threshold_sadc: 8000
  accept_energy_threshold_sadc: 20750
  min_adc_peak: 45
  min_samples_over_threshold: 10
  cluster_energy_cut_sadc: 22000
}


tamakerTPC_SWIFT_vd:
{
  module_type: TriggerActivityMakerTPC
  # tp_tag is set by the producer chain that uses this maker, next to the TP maker label
  algorithm: "TriggerActivityMakerSWIFTPlugin"
  #active_rops: []
  algconfig_rop0: @local::ta_algconfig_swift_vd
  algconfig_rop1: @local::ta_algconfig_swift_vd
  algconfig_rop2: @local::ta_algconfig_swift_vd
  flush: true
  verbosity: 0
}

END_PROLOG

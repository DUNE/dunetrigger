#include "triggersim_common_cfg.fcl"
#include "trigger_primitive_makers_vd_cfg.fcl"
#include "trigger_activity_makers_vd_cfg.fcl"
#include "tools_dune.fcl"


process_name: TriggerPrimitiveMaker

services: {
  @table::services_triggersim
	@table::dunefdvd_1x8x14_3view_30deg_reco_services
}

source:	@local::source_triggersim
outputs: @local::outputs_triggersim

physics:
{
  producers: {
    tpmakerTPCSimpleThreshold: @local::tpmakerTPC_ADCSimpleThreshold_vd    
    tamakerTPCSWIFT: @local::tamakerTPC_SWIFT_vd    
  }
  makers: [ tpmakerTPCSimpleThreshold, tamakerTPCSWIFT]
  trigger_paths: [makers]
  stream1:  [ out1 ]
  end_paths: [stream1]
}

outputs.out1.outputCommands: ["keep *_*_*_*", "drop raw::RawDigit*_*_*_*"] 



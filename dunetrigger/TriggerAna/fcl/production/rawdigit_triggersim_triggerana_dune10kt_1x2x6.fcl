#include "triggerana_tree.fcl"
#include "standard_detsim_dune10kt_1x2x6.fcl"
#include "tools_dune.fcl"

process_name: TriggerSimAna

services: {
    @table::services_triggerana_tree
    @table::dunefd_1x2x6_reco_services
}

# Keep the Geometry consistent with your 1x2x6 volume
services.Geometry: @local::dune10kt_1x2x6_v5_refactored_geo

source:  @local::source_triggerana_tree
outputs: @local::outputs_triggerana_tree

outputs.out1.outputCommands: [
  "keep *", 
  "drop raw::RawDigit*_*_*_*",
  "drop raw::OpDet*_*_*_*",
  "drop simb::OpDet*_*_*_*",
  "drop sim::OpDet*_*_*_*",
  "drop sim::SimEnergyDeposits*_*_*_*"
] 

# --- KLAUDIA'S PHYSICS BLOCK ---
physics: @local::physics_triggerana_simpleThr_absRS

# --- INTEGRATING PIERRE'S GENERATION ---
physics.producers.tpcrawdecoder: @local::tpcrawdecoder_dunefd_horizdrift_1x2x6

#  insert the decoder into the front of Klaudia's 'makers' sequence
# This ensures digits are made BEFORE the TPG runs
physics.makers: [ tpcrawdecoder, tpmakerTPCsimpleThr, tpmakerTPCabsRS ]

# ------- POINTING TO TAGS ----------

# Use the existing simpleSC truth from the input file
physics.analyzers.triggerAna.simchannel_tag: "tpcrawdecoder:simpleSC"

# But ensure the TPG makers use your NEW waveforms
physics.producers.tpmakerTPCsimpleThr.rawdigit_tag: "tpcrawdecoder:daq"
physics.producers.tpmakerTPCabsRS.rawdigit_tag:    "tpcrawdecoder:daq"
# triggerana_tree.fcl

# HD TriggerAna physics chains.
# The detector-independent analyzer settings live in triggerana_common.fcl

#include "triggerana_common.fcl"
#include "triggersim_hd_cfg.fcl"

BEGIN_PROLOG

## Basic example of a physics configuration, better to create your own
physics_triggerana_tree_simpleThr_simpleWin_simpleWin: {

  # basic producers from triggersim_hd_cfg.fcl
  producers: @local::producers_triggersim_simpleThr_simpleWin_simpleWin
  makers: [ tpmakerTPC, tamakerTPC, tcmakerTPC ]
  trigger_paths: [ makers ]

  # This is just a basic example that reads the trigger information from the TPC and dumps it to a tree
  # (equivalent to a reco2 step, if reco1 is generating trigger data from rawDigits).

  analyzers: {
    triggerAna: @local::triggerAnaTree_dumpAll
  }

  ana:            [ triggerAna ]
  stream1:        [ out1 ]
  end_paths:      [ stream1, ana ]
}

physics_triggerana_simpleThr_absRS: @local::physics_triggerana_tree_simpleThr_simpleWin_simpleWin
physics_triggerana_simpleThr_absRS.producers: @local::producers_triggersim_simpleThr_absRS
physics_triggerana_simpleThr_absRS.makers: [ tpmakerTPCsimpleThr, tpmakerTPCabsRS ]

END_PROLOG
